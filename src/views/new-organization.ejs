<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <% if (typeof error !== 'undefined') { %>

        <p class="error-message" role="alert">
            <%= error %>
        </p>

    <% } %>

    <form action="/new-organization" method="POST">

        <div>
            <label for="name">Organization Name:</label>

            <input
                type="text"
                id="name"
                name="name"
                value="<%= typeof name !== 'undefined' ? name : '' %>"
                required
                maxlength="100"
            >
        </div>

        <div>
            <label for="description">Description:</label>

            <textarea
                id="description"
                name="description"
                rows="5"
            ><%= typeof description !== 'undefined' ? description : '' %></textarea>
        </div>

        <div>
            <label for="contact_email">Contact Email:</label>

            <input
                type="email"
                id="contact_email"
                name="contact_email"
                value="<%= typeof contact_email !== 'undefined' ? contact_email : '' %>"
            >
        </div>

        <div>
            <label for="logo_filename">Logo Filename:</label>

            <input
                type="text"
                id="logo_filename"
                name="logo_filename"
                value="<%= typeof logo_filename !== 'undefined' ? logo_filename : '' %>"
            >
        </div>

        <button type="submit">Create Organization</button>

    </form>

</main>

<%- include('partials/footer') %>