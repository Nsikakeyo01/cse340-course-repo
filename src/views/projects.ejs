<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <p>
        Our service projects provide opportunities for volunteers to use
        their time and skills to support meaningful causes and strengthen
        communities.
    </p>

    <h2>Available Service Projects</h2>

    <% if (projects && projects.length > 0) { %>

        <ul>
            <% projects.forEach(project => { %>

                <li>
                    <strong>
                        <%= new Date(project.project_date).toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                            timeZone: 'UTC'
                        }) %>:
                        <%= project.title %>
                        (<%= project.organization_name %>)
                    </strong>

                    <p>
                        <%= project.description %>
                    </p>

                    <p>
                        <strong>Location:</strong>
                        <%= project.location %>
                    </p>
                </li>

            <% }) %>
        </ul>

    <% } else { %>

        <p>No service projects found.</p>

    <% } %>

</main>

<%- include('partials/footer') %>