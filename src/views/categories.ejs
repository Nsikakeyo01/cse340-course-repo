<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <% if (user && user.role==='admin' ) { %>
            <p>
                <a href="/new-category">Create New Category</a>
            </p>
            <% } %>

                <% if (messages && messages.notice && messages.notice.length> 0) { %>
                    <p class="success-message" role="status">
                        <%= messages.notice[0] %>
                    </p>
                    <% } %>

                        <p>
                            Explore service opportunities in different areas where volunteers
                            can contribute their time, skills, and efforts to make a positive
                            difference in their communities.
                        </p>

                        <h2>Service Project Categories</h2>

                        <% if (categories && categories.length> 0) { %>

                            <ul>

                                <% categories.forEach(category=> { %>

                                    <li>
                                        <h2>
                                            <a href="/category/<%= category.category_id %>">
                                                <%= category.name %>
                                            </a>
                                        </h2>
                                    </li>

                                    <% }) %>

                            </ul>

                            <% } else { %>

                                <p>No service project categories found.</p>

                                <% } %>

    </main>

    <%- include('partials/footer') %>