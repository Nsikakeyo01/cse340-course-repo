<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <p>
        Explore service opportunities in different areas where volunteers
        can contribute their time, skills, and efforts to make a positive
        difference in their communities.
    </p>

    <h2>Service Project Categories</h2>

    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>

        <ul>
            <% categories.forEach(category => { %>

                <li>
                    <h2><%= category.name %></h2>
                </li>

            <% }) %>
        </ul>

    <% } else { %>

        <p>No service project categories found.</p>

    <% } %>

</main>

<%- include('partials/footer') %>