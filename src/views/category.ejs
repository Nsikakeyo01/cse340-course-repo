<%- include('partials/header') %>

<main>

    <h1><%= category.name %></h1>

    <p>
        <a href="/edit-category/<%= category.category_id %>">
            Edit Category
        </a>
    </p>

    <h2>Service Projects</h2>

    <% if (projects && projects.length > 0) { %>

        <ul>

            <% projects.forEach(project => { %>

                <li>

                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>

                </li>

            <% }) %>

        </ul>

    <% } else { %>

        <p>No service projects are currently assigned to this category.</p>

    <% } %>

</main>

<%- include('partials/footer') %>