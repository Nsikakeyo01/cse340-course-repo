<%- include('partials/header') %>

    <main>

        <% if (messages && messages.notice && messages.notice.length> 0) { %>
            <p class="success-message" role="status">
                <%= messages.notice[0] %>
            </p>
            <% } %>

                <h1>
                    <%= project.title %>
                </h1>

                <% if (user && user.role==='admin' ) { %>
                    <p>
                        <a href="/edit-project/<%= project.project_id %>">
                            Edit Project
                        </a>
                    </p>
                    <% } %>

                        <p>
                            <strong>Description:</strong>
                            <%= project.description %>
                        </p>

                        <p>
                            <strong>Date:</strong>
                            <%= project.date %>
                        </p>

                        <p>
                            <strong>Location:</strong>
                            <%= project.location %>
                        </p>

                        <p>
                            <strong>Organization:</strong>
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>

                        <h2>Categories</h2>

                        <% if (categories && categories.length> 0) { %>
                            <ul>
                                <% categories.forEach(category=> { %>
                                    <li>
                                        <a href="/category/<%= category.category_id %>">
                                            <%= category.name %>
                                        </a>
                                    </li>
                                    <% }) %>
                            </ul>
                            <% } else { %>
                                <p>No categories assigned to this project.</p>
                                <% } %>

                                    <% if (user && user.role==='admin' ) { %>
                                        <p>
                                            <a href="/update-project-categories/<%= project.project_id %>">
                                                Update Project Categories
                                            </a>
                                        </p>
                                        <% } %>

                                            <!-- W06 VOLUNTEERING FEATURE -->
                                            <% if (user) { %>

                                                <section class="volunteer-section">

                                                    <h2>Volunteering</h2>

                                                    <% if (isVolunteer) { %>

                                                        <p>
                                                            You are volunteering for this project.
                                                        </p>

                                                        <form
                                                            action="/project/<%= project.project_id %>/remove-volunteer"
                                                            method="POST">

                                                            <button type="submit">
                                                                Remove Volunteering
                                                            </button>

                                                        </form>

                                                        <% } else { %>

                                                            <p>
                                                                Interested in helping with this project?
                                                            </p>

                                                            <form action="/project/<%= project.project_id %>/volunteer"
                                                                method="POST">

                                                                <button type="submit">
                                                                    Volunteer for This Project
                                                                </button>

                                                            </form>

                                                            <% } %>

                                                </section>

                                                <% } %>

    </main>

    <%- include('partials/footer') %>