<%- include('partials/header') %>

<main>
    <h1><%= organization.name %></h1>

    <% if (organization.logo_filename) { %>
        <img
            src="/images/<%= organization.logo_filename %>"
            alt="<%= organization.name %> logo"
        >
    <% } %>

    <p>
        <strong>Description:</strong>
        <%= organization.description %>
    </p>

    <p>
        <strong>Contact Email:</strong>
        <a href="mailto:<%= organization.contact_email %>">
            <%= organization.contact_email %>
        </a>
    </p>

    <h2>Service Projects</h2>

    <% if (projects && projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No service projects are currently associated with this organization.</p>
    <% } %>
</main>

<%- include('partials/footer') %>