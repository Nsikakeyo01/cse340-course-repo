<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <p>
        We work with organizations that are committed to creating meaningful
        service opportunities and making a positive impact in communities.
    </p>

    <h2>Our Partner Organizations</h2>

    <% if (typeof organizations !== 'undefined' && organizations.length > 0) { %>

        <ul>
            <% organizations.forEach(organization => { %>

                <li>
                    <img
                        src="/images/<%= organization.logo_filename %>"
                        alt="<%= organization.name %> logo"
                    >

                    <h2><%= organization.name %></h2>

                    <p>
                        <%= organization.description %>
                    </p>

                    <p>
                        <strong>Email:</strong>
                        <a href="mailto:<%= organization.contact_email %>">
                            <%= organization.contact_email %>
                        </a>
                    </p>
                </li>

            <% }); %>
        </ul>

    <% } else { %>

        <p>No partner organizations found.</p>

    <% } %>

</main>

<%- include('partials/footer') %>